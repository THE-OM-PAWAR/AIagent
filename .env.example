# Telegram Bot Configuration
# Obtain your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Access Control: Comma-separated list of authorized Telegram user IDs
# Obtain your numeric Telegram ID from @userinfobot or @raw_data_bot
ALLOWED_TELEGRAM_USER_IDS=123456789

# Google Gemini API Configuration
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_SYSTEM_INSTRUCTION=You are a helpful, respectful, and concise personal AI assistant.
GEMINI_TIMEOUT_SECONDS=60.0

# Model Tier Pool (Phase 4 Model Routing)
MODEL_TIER_SMALL=gemini-2.5-flash
MODEL_TIER_MEDIUM=gemini-2.5-flash
MODEL_TIER_LARGE=gemini-1.5-pro

# Application Settings
LOG_LEVEL=INFO
ENVIRONMENT=production

# Neon PostgreSQL / SQLAlchemy Database Configuration
# Direct or pooled Neon connection string (auto-normalized to postgresql+asyncpg://)
DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_POOLED=postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Qdrant Vector Storage Configuration
# Set to :memory: for local testing, or https://xyz.cloud.qdrant.io:6333 for production
QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=aiagent_memories

# Embedding & Retrieval Pipeline
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=3072
MEMORY_TOP_K=5
MEMORY_SIMILARITY_THRESHOLD=0.65

# Docker Image Configuration (for GHCR / pre-built production images)
# AIAGENT_IMAGE=ghcr.io/your-username/aiagent
# IMAGE_TAG=latest
