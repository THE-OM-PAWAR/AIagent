# Telegram Bot Configuration
# Obtain your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Access Control: Comma-separated list of authorized Telegram user IDs
# Obtain your numeric Telegram ID from @userinfobot or @raw_data_bot
ALLOWED_TELEGRAM_USER_IDS=123456789

# Google Gemini API Configuration
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_SYSTEM_INSTRUCTION=You are a helpful, respectful, and concise personal AI assistant.
GEMINI_TIMEOUT_SECONDS=60.0

# MongoDB Root Authentication (Container Initialization)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change_this_root_password_here

# MongoDB Application Database & User
MONGO_APP_USERNAME=aiagent_user
MONGO_APP_PASSWORD=change_this_app_password_here
MONGODB_DB_NAME=telegram_ai_bot
CONVERSATION_HISTORY_LIMIT=20

# Application MongoDB Connection URI (used by app service within Docker network)
MONGODB_URI=mongodb://aiagent_user:change_this_app_password_here@mongo:27017/telegram_ai_bot?authSource=telegram_ai_bot

# Nginx Gateway Ports
NGINX_PORT_HTTP=80
NGINX_PORT_HTTPS=443

# Application Settings
LOG_LEVEL=INFO
ENVIRONMENT=production

# Docker Image Configuration (for GHCR / pre-built production images)
# AIAGENT_IMAGE=ghcr.io/your-username/aiagent
# IMAGE_TAG=latest
